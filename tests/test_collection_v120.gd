extends SceneTree
var failures=0
func check(ok: bool,message: String):
 if not ok:failures+=1;printerr(message)
func _initialize():call_deferred("run")
func run():
 var game=load("res://main.gd").new();root.add_child(game);game.set_process(false);game.test_mode=true
 var n=game.notebook;n.save_path="user://test_collection_v120.cfg"
 n.coins=0;n.earned=0;n.spent=0;n.owned=[];n.task_cursor=0;n.values={};n.done=[];n.total_completed=0;n.cycle=0
 game.start_game()
 check(n.active==["first_steps"],"Exactly one initial challenge")
 n.event("dogs",50);check(n.current_value()==0,"Inactive actions ignored")
 n.event("kills",25);game.finish(false);game.start_game()
 check(n.current_value()==25 and n.task_cursor==0,"Unfinished cumulative challenge survives defeat")
 n.event("kills",25)
 check(n.coins==100 and n.task_cursor==1 and n.current_value()==0,"One reward, immediate next challenge")
 n.event("kills",1000);check(n.coins==100,"No repeat credit")
 n.clean_seconds=39;n.on_damage();n.tick(1)
 check(n.current_value()==1,"Damage resets consecutive survival")
 n.event("clean",40,true)
 check(n.task_cursor==2 and n.coins==200,"Clean challenge advances")
 for i in 20:game.apply_pickup("double")
 check(n.task_cursor==3,"Actual gift hooks")
 for i in 3:game.special_slots.clear();game.special_slots.append("dogs");game.use_special(0)
 check(n.task_cursor==4,"Actual dog activation hooks")
 n.event("kills",99);game.finish(false);game.start_game()
 check(n.current_value()==0 and n.task_cursor==4,"One-run challenge resets but stays active")
 n.event("kills",100);n.event("dogs",5);n.event("boxes",10)
 check(n.task_cursor==7 and n.coins==700,"Ordered rewards through gift challenge")
 game.score=50000;n.tick(0.1)
 check(n.task_cursor==8 and n.coins==800,"Score milestone reward")
 game.start_game()
 for i in range(1,7):game.collect_slingshot(i)
 check(n.task_cursor==9 and n.coins==1000,"All six slings required")
 n.clean_seconds=119;game.apply_pickup("trap");n.tick(0.1)
 check(n.current_value()==0,"Trap breaks two-minute streak")
 n.clean_seconds=120;n.tick(0.1)
 check(n.task_cursor==10 and n.coins==1200,"Two minutes reward")
 game.score=120000;n.tick(0.1)
 check(n.task_cursor==0 and n.coins==1400 and n.cycle==1,"Full series repeats for 1400 coins")
 check(n.total_completed==11 and n.done.size()==11,"History and totals")
 n.event("kills",50);check(n.coins==1500 and n.task_cursor==1,"Repeated challenges earn again")
 n.save_data()
 var restored=load("res://progression/notebook.gd").new();restored.setup(game,n.save_path)
 check(restored.coins==1500 and restored.task_cursor==1,"Wallet and active challenge reload")
 var expected_counts=[20,20,20,14,10]
 for i in n.CATEGORIES.size():
  var cat=n.CATEGORIES[i]
  check(n.items_for(cat).size()==expected_counts[i],"Category count "+cat)
  check(n.visible_items(cat).size()==1,"Future items hidden "+cat)
 check(n.catalog.size()==84,"Exactly 84 articles")
 var shoes=n.items_for("shoes")
 check(shoes[17].name=="Renard furtif" and shoes[18].name=="Nuages aux pieds" and shoes[19].name=="Trophées ambulants","Shoe final order")
 check(n.items_for("hats")[-1].name=="Le champignon suspect","Last hat")
 check(n.items_for("costumes")[-2].name=="Camembert justicier","Costume final order")
 check(not n.buy(shoes[1].id),"Cannot purchase future item")
 check(not n.equip_item(shoes[0].id),"Cannot equip unowned item")
 check(n.buy(shoes[0].id),"First purchase works")
 check(n.coins==500 and n.equipped.shoes=="","Purchase debits without equipping")
 check(not n.buy(shoes[0].id) and n.coins==500,"Duplicate purchase not charged")
 check(n.visible_items("shoes").size()==2,"Purchase reveals exactly next article")
 check(not n.buy(shoes[1].id) and n.coins==500,"Insufficient funds leaves wallet intact")
 check(n.equip_item(shoes[0].id),"Owned item can be equipped later")
 var fingerprint=[game.shot_interval(),game.enemy_speed_multiplier(),game.max_active_enemies(),game.player_speed(),game.rng.state]
 n.coins=117000
 var original=game.character_tex.get_image();original.decompress()
 var face=Rect2i(original.get_width()/4,0,original.get_width()/4,int(original.get_height()/3*0.47))
 for item in n.catalog:
  if not n.owned.has(item.id):check(n.buy(item.id),"Buy all in category order "+item.id)
  check(n.equip_item(item.id),"Equip all items "+item.id)
  check(n.renderer.region(item.category,item.sprite*(2 if item.category=="costumes" else 1)).size.x>0,"Valid item region "+item.id)
 check(fingerprint==[game.shot_interval(),game.enemy_speed_multiplier(),game.max_active_enemies(),game.player_speed(),game.rng.state],"Cosmetics preserve combat and RNG")
 check(n.owned.size()==84,"Complete collection obtainable")
 var costumes=n.items_for("costumes")
 n.equip_item(costumes[0].id);n.equip_item(shoes[0].id)
 check(n.equipped.costumes=="","Separate article removes full costume")
 n.remove_item("shoes");check(n.equipped.shoes=="","Can remove owned article")
 n.equip_item(n.items_for("tops")[-1].id)
 var styled=n.renderer.hero_texture(game.character_tex,n.equipped).get_image()
 check(styled.get_region(face).get_data()==original.get_region(face).get_data(),"Facial pixels unchanged")
 var cell=Vector2i(original.get_width()/4,original.get_height()/3)
 for id in range(2,11):
  var r=Rect2i(Vector2i(id%4,id/4)*cell,cell)
  check(styled.get_region(r).get_data()==original.get_region(r).get_data(),"NPC artwork unchanged")
 var before=n.coins;n.save_path="/not-writable/test.cfg";n.owned.erase(shoes[-1].id)
 check(not n.buy(shoes[-1].id) and n.coins==before and not n.owned.has(shoes[-1].id),"Failed save rolls purchase back")
 n.save_path="user://test_collection_v120.cfg";n.save_data()
 var reloaded=load("res://progression/notebook.gd").new();reloaded.setup(game,n.save_path)
 check(reloaded.owned==n.owned and reloaded.equipped==n.equipped,"Owned and equipped reload")
 for t in n.TASKS:
  check(game.menu_translations.has(t.title) and game.menu_translations.has(t.text),"Challenge translations "+t.id)
 for item in n.catalog:check(game.menu_translations.has(item.name),"Item translation "+item.id)
 for suffix in ["",".bak",".tmp"]:
  if FileAccess.file_exists(n.save_path+suffix):DirAccess.remove_absolute(n.save_path+suffix)
 print("COLLECTION_FAILURES=",failures)
 game.queue_free();await process_frame;quit(1 if failures else 0)
